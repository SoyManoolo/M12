# Aplicación
NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:5173

# PostgreSQL local. Deja DATABASE_URL sin definir para usar estos valores.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=friendsgo
DB_USER=postgres
DB_PASS=change_me
DB_UPDATE=true

# Seguridad
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Mantenimiento
LOGS_DAYS=7
CLEAN_USERS=30
CLEAN_POSTS=15
CLEAN_COMMENTS=7
